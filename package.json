{
  "name": "canvas-assignment-bot",
  "version": "0.1.3",
  "description": "Instructure Canvas assignment bot API for daily task reports and assignment guidance.",
  "author": "Bonehawk Canvas",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc",
    "desktop:dev": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --config electron-builder.config.cjs --mac --dir --publish never",
    "desktop:dist": "npm run build && electron-builder --config electron-builder.config.cjs --mac dmg zip --publish never",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.17.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.2",
    "@types/nodemailer": "^7.0.4",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
